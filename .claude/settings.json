{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run ty*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/credentials/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./**/id_rsa.*)",
      "Read(./**/service-account*.json)",
      "Read(./**/service_account*.json)",
      "Read(./**/credentials.json)",
      "Read(./**/token.json)",
      "Read(./.mcp.json)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./**/.env)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat */.env*)",
      "Bash(type .env*)",
      "Bash(type ./.env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(set)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-file-size.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-python.py\"",
            "if": "Edit(**/*.py)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-python.py\"",
            "if": "Write(**/*.py)",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-agent-model.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-workflow-model.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-secrets.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-lint.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 120,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive-git.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-japanese.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-verification.py\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "token-weather@claude-code-playground-mods": true,
    "blast-radius@claude-code-playground-mods": true
  },
  "extraKnownMarketplaces": {
    "claude-code-playground-mods": {
      "source": {
        "source": "settings",
        "name": "claude-code-playground-mods",
        "plugins": [
          {
            "name": "token-weather",
            "source": {
              "source": "git-subdir",
              "url": "https://github.com/anthropics/claude-code-playground.git",
              "path": "claude-code/mods/token-weather",
              "sha": "569c5283d9a0a7ee7938df85bb32e4f48cbb8c86"
            }
          },
          {
            "name": "blast-radius",
            "source": {
              "source": "git-subdir",
              "url": "https://github.com/anthropics/claude-code-playground.git",
              "path": "claude-code/mods/blast-radius",
              "sha": "569c5283d9a0a7ee7938df85bb32e4f48cbb8c86"
            }
          }
        ],
        "owner": {
          "name": "anthropics/claude-code-playground"
        }
      }
    }
  },
  "language": "japanese"
}
